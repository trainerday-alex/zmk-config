/*
 * Converted from Vial layout to ZMK
 * Original: keyboard.vil
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Base Layer
        default_layer {
            bindings = <
   &none     &kp Q         &kp W         &kp E         &kp R           &kp T              &kp Y     &kp U           &kp I         &kp O         &kp P          &kp SQT
   &kp PG_UP &mt LSHFT A   &mt LALT S    &mt LCTRL D   &mt LGUI F      &kp G              &kp H     &mt RGUI J      &mt RCTRL K   &mt RALT L    &mt RSHFT SEMICOLON &kp SQT
   &kp PG_DN &kp Z         &kp X         &kp C         &kp V           &kp B              &kp N     &kp M           &kp COMMA     &kp DOT       &kp SLASH      &kp LG(ESC)
                                         &lt 3 F16     &lt 2 ESC       &lt 1 TAB          &lt 1 BSPC &kp SPACE     &lt 2 RET
            >;
        };

        // Layer 1: Numbers and Symbols
        numbers_layer {
            bindings = <
   &none      &kp UNDER     &kp TILDE     &kp LBKT      &kp RBKT        &kp EXCL           &kp HOME  &kp KP_MULTIPLY &kp N9        &kp N8        &kp N7         &kp KP_PLUS
   &kp CARET  &kp HASH      &kp DOLLAR    &kp LPAR      &kp RPAR        &kp AT             &kp RA(HOME) &kp KP_DIVIDE &kp N6        &kp N5        &kp N4         &kp KP_MINUS
   &none      &kp PRCNT     &kp PIPE      &kp LBRC      &kp RBRC        &kp AMPS           &none     &kp KP_EQUAL    &kp N3        &kp N2        &kp N1         &kp KP_N0
                                          &trans        &trans          &trans             &trans    &kp LG(Z)       &trans
            >;
        };

        // Layer 2: Navigation and Alt shortcuts
        nav_layer {
            bindings = <
   &none      &kp LA(N1)    &kp LA(N2)    &kp LA(N3)    &kp LA(N4)      &kp LA(N5)         &none     &none           &kp LA(N9)    &none         &none          &none
   &none      &none         &none         &none         &none           &none              &kp LEFT  &kp DOWN        &kp UP        &kp RIGHT     &none          &none
   &none      &none         &none         &none         &none           &none              &none     &none           &none         &none         &none          &none
                                          &trans        &trans          &trans             &trans    &none           &trans
            >;
        };

        // Layer 3: Function Keys
        function_layer {
            bindings = <
   &none      &kp F1        &kp F2        &kp F3        &kp F4          &kp F5             &kp F12   &kp F11         &kp F10       &kp F9        &kp F8         &kp F7
   &none      &none         &none         &none         &none           &none              &none     &none           &none         &none         &none          &none
   &none      &none         &none         &none         &none           &none              &none     &none           &none         &none         &none          &none
                                          &trans        &trans          &trans             &trans    &trans          &trans
            >;
        };
    };
};
